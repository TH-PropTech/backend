{
  "name": "@th-proptech/backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@scarf/scarf",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "node --max-old-space-size=2048 ./node_modules/@nestjs/cli/bin/nest.js build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "seed": "ts-node -r tsconfig-paths/register -r dotenv/config src/data/dataSeeder.ts",
    "seed:legal": "ts-node -r tsconfig-paths/register -r dotenv/config src/scripts/seed-legal-knowledge.ts",
    "transfer-landlord": "ts-node -r tsconfig-paths/register -r dotenv/config src/scripts/transfer-landlord.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "node --max-old-space-size=2048 ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node --max-old-space-size=2048 ./node_modules/vitest/vitest.mjs",
    "test:cov": "node --max-old-space-size=3072 ./node_modules/vitest/vitest.mjs run --coverage",
    "test:e2e": "node --max-old-space-size=2048 ./node_modules/vitest/vitest.mjs run --config ./vitest.e2e.config.ts",
    "db:up": "docker compose up -d mongodb",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f mongodb",
    "prepare": "husky",
    "release": "standard-version",
    "migrate:data": "node scripts/run-migration.cjs",
    "check:structure": "node scripts/check-module-structure.cjs",
    "check:cycles": "node scripts/check-module-cycles.cjs"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@hyperledger/fabric-gateway": "^1.11.0",
    "@nestjs/common": "^11.1.13",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.13",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.13",
    "@nestjs/platform-ws": "^11.1.27",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.27",
    "@pdf-lib/fontkit": "^1.1.1",
    "@signpdf/placeholder-plain": "^3.3.0",
    "@signpdf/utils": "^3.3.0",
    "archiver": "8.0.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cloudinary": "^2.11.0",
    "cron": "4.4.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "joi": "^17.13.3",
    "mongodb": "^6.16.0",
    "multer": "^1.4.5-lts.1",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.20.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.26",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.1",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.13",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.41",
    "@types/archiver": "8.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.10.1",
    "@types/node-forge": "^1.3.14",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "madge": "^8.0.0",
    "prettier": "^3.6.2",
    "standard-version": "^9.5.0",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.48.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^3.2.7"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,js,cjs,mjs,yml,yaml}": [
      "prettier --write"
    ]
  }
}
