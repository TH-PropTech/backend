NODE_ENV=local
APP_PORT=3001
APP_URL=http://localhost:3001
APP_CORS_ORIGINS=http://localhost:3000
GROQ_API_KEY=

DATABASE_URL=mongodb://localhost:27017/th_proptech
DATABASE_LOGGING=false
DATABASE_SYNCHRONIZE=false
REDIS_URL=redis://localhost:6379
RECOMMENDATION_API_URL=http://localhost:5001/api

# Hosted Python eKYC service. Do not include the trailing /api path.
EKYC_SERVICE_URL=https://ekyc-16a1635d00b1.herokuapp.com
# Optional face extraction target; defaults to EKYC_SERVICE_URL during migration.
THEKYC_SERVICE_URL=https://thekyc.example.com
EKYC_REQUEST_TIMEOUT_MS=60000

# Generate a unique 32-byte key for each environment: `openssl rand -hex 32`.
# Required in production. Never reuse this placeholder as a real key.
KYC_MEDIA_ENCRYPTION_KEY=
KYC_PRIVATE_MEDIA_DIR=.data/kyc

# Cloudinary storage for apartment listing images (POST /apartments/upload).
# Leave empty locally: the upload endpoint then answers 503 until these are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# === Hyperledger Fabric (blockchain/setup/05-connect-backend.md) ===
# FABRIC_ENABLED=false  -> FabricService chạy Simulation Mode (txHash giả lập, không ghi ledger)
FABRIC_ENABLED=false
FABRIC_EXPLORER_TX_URL_TEMPLATE=
FABRIC_OUTBOX_POLL_INTERVAL_MS=5000
RENTAL_FLOW_V4_ENABLED=false
PAYMENT_PROVIDER=mock-bank
MOCK_BANK_BASE_URL=http://localhost:3001
# Required only when the v4 Mock Bank callback is enabled; use a per-environment secret.
MOCK_BANK_SECRET=
VNPAY_GATEWAY_URL=http://localhost:8888/order/create_payment_for_transaction
VNPAY_RETURN_URL=http://localhost:3001/api/v1/bank/vnpay/return
VNPAY_HASH_SECRET=
VNPAY_CLIENT_RETURN_URL=http://localhost:3000
FABRIC_MSP_ID=Org1MSP
FABRIC_CHANNEL_NAME=proptech-channel
FABRIC_CHAINCODE_NAME=proptech
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com
# Path được resolve theo process.cwd(). Chạy `pnpm dev` từ backend/ thì relative dưới đây đúng.
# Trên EC2 (systemd/docker) PHẢI dùng absolute path — script 02-network-up.sh sinh sẵn ở blockchain/fabric.env
FABRIC_CERT_PATH=../blockchain/crypto/org1-user-msp/signcerts/cert.pem
FABRIC_KEY_PATH=../blockchain/crypto/org1-user-msp/keystore/
FABRIC_TLS_CERT_PATH=../blockchain/crypto/peer-tls-ca.crt
# Identity tách vai trò (PROP-399 D5) — chỉ đường dẫn file/secret mount, KHÔNG bao giờ để nội dung khóa trong env.
# Do blockchain/scripts/05-enroll-identities.sh sinh ra dưới blockchain/crypto/identities/<role>/.
# PRODUCTION BẮT BUỘC cấu hình đủ writer/reader/operator và khác nhau; FABRIC_CERT_PATH/FABRIC_KEY_PATH ở trên chỉ là
# chế độ tương thích (dùng chung một identity cho mọi vai trò) ngoài production và bị từ chối với FABRIC_IDENTITY_SEPARATION_REQUIRED.
FABRIC_WRITER_CERT_PATH=
FABRIC_WRITER_KEY_PATH=
FABRIC_READER_CERT_PATH=
FABRIC_READER_KEY_PATH=
FABRIC_OPERATOR_CERT_PATH=
FABRIC_OPERATOR_KEY_PATH=
# (Tùy chọn) chứng chỉ CÔNG KHAI của Explorer, chỉ để readiness chứng minh nó không dùng chung identity với backend.
FABRIC_EXPLORER_CERT_PATH=
# Cảnh báo FABRIC_IDENTITY_EXPIRING khi chứng chỉ còn <= N ngày (1-365).
FABRIC_IDENTITY_EXPIRY_WARN_DAYS=30
# Explorer (độc lập với gateway). Production: URL https, không credential/query/fragment, không localhost.
FABRIC_EXPLORER_ENABLED=false
FABRIC_EXPLORER_PUBLIC_URL=
FABRIC_EXPLORER_HEALTH_URL=
# Giới hạn gói bằng chứng hợp đồng và đối soát ledger.
EVIDENCE_PACKAGE_MAX_FILES=50
EVIDENCE_PACKAGE_MAX_BYTES=104857600
FABRIC_RECONCILIATION_PAGE_SIZE=100
FABRIC_RECONCILIATION_ORPHAN_PAGE_BUDGET=10
FABRIC_RECONCILIATION_MAX_CONTRACTS=500

# === Rental operations ===
RENTAL_SCHEDULER_ENABLED=false
DEPOSIT_AGREEMENT_TTL_HOURS=72
RENTAL_STUCK_PROVISIONING_FAILED_MINUTES=30
RENTAL_STUCK_DEPOSIT_ATTEMPT_EXPIRED_MINUTES=15
RENTAL_STUCK_DEPOSIT_UNPAID_HOURS=24
RENTAL_STUCK_SIGNED_PENDING_DEPOSIT_HOURS=24
RENTAL_STUCK_ACTIVATION_FAILURE_MINUTES=15
RENTAL_STUCK_LEDGER_FAILED_TERMINAL_MINUTES=15
RENTAL_STUCK_SETTLEMENT_OVERDUE_HOURS=24
RENTAL_STUCK_HANDOVER_OVERDUE_HOURS=24
