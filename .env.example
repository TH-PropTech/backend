NODE_ENV=local
APP_PORT=3001
APP_URL=http://localhost:3001
APP_CORS_ORIGINS=http://localhost:3000
# Rate limit toàn cục (ThrottlerGuard): số request tối đa mỗi cửa sổ thời gian (ms) cho mỗi IP
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
GROQ_API_KEY=
# Optional comma-separated keys from different Groq accounts; tried in order, next key used when one is rate limited
GROQ_API_KEYS=
# Keys added by admins in the "API Key AI" tab are stored encrypted in MongoDB and used first;
# local keys above are the fallback. Required (>= 32 chars, e.g. `openssl rand -hex 32`) to use that tab.
# GROQ_KEY_ENCRYPTION_SECRET=

# Force Node to use public DNS so MongoDB Atlas SRV lookups work (avoids querySrv ECONNREFUSED)
NODE_DNS_SERVERS=8.8.8.8,1.1.1.1
DATABASE_URL=mongodb://localhost:27017/th_proptech
DATABASE_LOGGING=false
DATABASE_SYNCHRONIZE=false
REDIS_URL=redis://localhost:6379
RECOMMENDATION_API_URL=http://localhost:5001/api

# Hosted Python eKYC service. Do not include the trailing /api path.
EKYC_SERVICE_URL=https://ekyc-16a1635d00b1.herokuapp.com
# Optional face extraction target; defaults to EKYC_SERVICE_URL during migration.
THEKYC_SERVICE_URL=https://thekyc.example.com
EKYC_REQUEST_TIMEOUT_MS=60000

# Generate a unique 32-byte key for each environment: `openssl rand -hex 32`.
# Required in production. Never reuse this placeholder as a real key.
KYC_MEDIA_ENCRYPTION_KEY=
KYC_PRIVATE_MEDIA_DIR=.data/kyc

# Cloudinary storage for apartment listing images (POST /apartments/upload).
# Leave empty locally: the upload endpoint then answers 503 until these are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# === Hyperledger Fabric (blockchain/setup/05-connect-backend.md) ===
# FABRIC_ENABLED=false  -> FabricService chạy Simulation Mode (txHash giả lập, không ghi ledger)
FABRIC_ENABLED=false
FABRIC_EXPLORER_TX_URL_TEMPLATE=
FABRIC_OUTBOX_POLL_INTERVAL_MS=5000
# Legal terms two-step review: when false (default) the admin who last edited a draft cannot approve it.
# A single-admin demo may set true; production should keep false.
LEGAL_TERMS_ALLOW_SELF_APPROVAL=false
RENTAL_FLOW_V4_ENABLED=false
MOCK_BANK_BASE_URL=http://localhost:3001
# Required only when the v4 Mock Bank callback is enabled; use a per-environment secret.
MOCK_BANK_SECRET=

# === Payment gateways (MoMo / ZaloPay / Mộc Bank sandbox) ===
# Comma list the tenant may choose from: mock-bank,momo,zalopay,mocbank (default: mock-bank).
# A gateway's keys become required as soon as it is listed. Never commit real keys.
PAYMENT_PROVIDERS_ENABLED=mock-bank
PAYMENT_GATEWAY_TIMEOUT_MS=10000
PAYMENT_ATTEMPT_TTL_MINUTES=15
PAYMENT_CLIENT_RETURN_URL=http://localhost:3000
PAYMENT_MOBILE_RETURN_URL=thproptech://payment-result
# Optional order-query (reconciliation) endpoints; default derived from the create endpoint / sandbox.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
# MOMO_QUERY_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/query
MOMO_RETURN_URL=http://localhost:3001/api/v1/bank/momo/return
MOMO_IPN_URL=http://localhost:3001/api/v1/bank/momo/ipn
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/create
# ZALOPAY_QUERY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/query
ZALOPAY_RETURN_URL=http://localhost:3001/api/v1/bank/zalopay/return
ZALOPAY_CALLBACK_URL=http://localhost:3001/api/v1/bank/zalopay/callback
# Mộc Bank: Return URL and Webhook URL must be registered on Mộc Bank exactly as set here.
# MOCBANK_WEBHOOK_URL needs a public HTTPS URL (tunnel when local); required in production.
# When empty, Mộc Bank uses the first Webhook URL registered on the merchant app.
MOCBANK_BASE_URL=https://bank-sanboxv1.vercel.app
MOCBANK_MERCHANT_ID=
MOCBANK_MERCHANT_SECRET=
MOCBANK_RETURN_URL=http://localhost:3001/api/v1/bank/mocbank/return
MOCBANK_WEBHOOK_URL=
# Local IPN testing: gateways cannot reach localhost. Run a tunnel, e.g.
#   cloudflared tunnel --url http://localhost:3001
# then point MOMO_IPN_URL / ZALOPAY_CALLBACK_URL at the tunnel host.
# Without a tunnel, payments still settle through the signed browser return.
FABRIC_MSP_ID=Org1MSP
FABRIC_CHANNEL_NAME=proptech-channel
FABRIC_CHAINCODE_NAME=proptech
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com
# Path được resolve theo process.cwd(). Chạy `pnpm dev` từ backend/ thì relative dưới đây đúng.
# Trên EC2 (systemd/docker) PHẢI dùng absolute path — script 02-network-up.sh sinh sẵn ở blockchain/fabric.env
FABRIC_CERT_PATH=../blockchain/crypto/org1-user-msp/signcerts/cert.pem
FABRIC_KEY_PATH=../blockchain/crypto/org1-user-msp/keystore/
FABRIC_TLS_CERT_PATH=../blockchain/crypto/peer-tls-ca.crt
# Identity tách vai trò (PROP-399 D5) — chỉ đường dẫn file/secret mount, KHÔNG bao giờ để nội dung khóa trong env.
# Do blockchain/scripts/05-enroll-identities.sh sinh ra dưới blockchain/crypto/identities/<role>/.
# PRODUCTION BẮT BUỘC cấu hình đủ writer/reader/operator và khác nhau; FABRIC_CERT_PATH/FABRIC_KEY_PATH ở trên chỉ là
# chế độ tương thích (dùng chung một identity cho mọi vai trò) ngoài production và bị từ chối với FABRIC_IDENTITY_SEPARATION_REQUIRED.
FABRIC_WRITER_CERT_PATH=
FABRIC_WRITER_KEY_PATH=
FABRIC_READER_CERT_PATH=
FABRIC_READER_KEY_PATH=
FABRIC_OPERATOR_CERT_PATH=
FABRIC_OPERATOR_KEY_PATH=
# (Tùy chọn) chứng chỉ CÔNG KHAI của Explorer, chỉ để readiness chứng minh nó không dùng chung identity với backend.
FABRIC_EXPLORER_CERT_PATH=
# Cảnh báo FABRIC_IDENTITY_EXPIRING khi chứng chỉ còn <= N ngày (1-365).
FABRIC_IDENTITY_EXPIRY_WARN_DAYS=30
# Explorer (độc lập với gateway). Production: URL https, không credential/query/fragment, không localhost.
FABRIC_EXPLORER_ENABLED=false
FABRIC_EXPLORER_PUBLIC_URL=
FABRIC_EXPLORER_HEALTH_URL=
# Giới hạn gói bằng chứng hợp đồng và đối soát ledger.
EVIDENCE_PACKAGE_MAX_FILES=50
EVIDENCE_PACKAGE_MAX_BYTES=104857600
FABRIC_RECONCILIATION_PAGE_SIZE=100
FABRIC_RECONCILIATION_ORPHAN_PAGE_BUDGET=10
FABRIC_RECONCILIATION_MAX_CONTRACTS=500

# === Rental operations ===
RENTAL_SCHEDULER_ENABLED=false
DEPOSIT_AGREEMENT_TTL_HOURS=72
RENTAL_STUCK_PROVISIONING_FAILED_MINUTES=30
RENTAL_STUCK_DEPOSIT_ATTEMPT_EXPIRED_MINUTES=15
RENTAL_STUCK_DEPOSIT_UNPAID_HOURS=24
RENTAL_STUCK_SIGNED_PENDING_DEPOSIT_HOURS=24
RENTAL_STUCK_ACTIVATION_FAILURE_MINUTES=15
RENTAL_STUCK_LEDGER_FAILED_TERMINAL_MINUTES=15
RENTAL_STUCK_SETTLEMENT_OVERDUE_HOURS=24
RENTAL_STUCK_HANDOVER_OVERDUE_HOURS=24

# === VNPT SmartCA v1 (signing happens in the VNPT SmartCA app; no signer password/OTP here) ===
# SMARTCA_ENV: mock (offline, simulates 3s approval) | test | production
SMARTCA_ENV=mock
# Dev/test only: bật endpoint POST /contracts/:id/test-sign (ký bỏ qua SmartCA). Luôn false ở production.
ENABLE_TEST_SIGN_BYPASS=false
# Phương thức ký (CSV): smartca_v1, biometric_smart_otp. smartca_v2 chỉ bật bằng SMARTCA_V2_ENABLED (mật khẩu + OTP SmartCA, tắt mặc định).
SIGNING_METHODS=smartca_v1,biometric_smart_otp
SMARTCA_V2_ENABLED=false
# Bản PDF đã ký PAdES (chỉ với VNPT thật, tắt mặc định). Tùy chọn: SMARTCA_PADES_REASON, _LOCATION, _CONTACT, _CREATOR.
SMARTCA_PADES_ENABLED=false
SMARTCA_TEST_API_URL=
# Client ID = SMARTCA_TEST_SP_ID; Client Secret = SMARTCA_TEST_SP_PASSWORD
SMARTCA_TEST_SP_ID=
SMARTCA_TEST_SP_PASSWORD=
SMARTCA_API_URL=
SMARTCA_SP_ID=
SMARTCA_SP_PASSWORD=
# Optional overrides (defaults: /sca/sp769/v1/signatures/sign)
SMARTCA_SIGN_PATH=
SMARTCA_TEST_SIGN_PATH=
SMARTCA_SIGNING_TIMEOUT_MS=300000

# Dev only: cho phep nop KYC chi voi anh CCCD (bo selfie + liveness). Luon bi bo qua khi NODE_ENV=production.
KYC_SKIP_SELFIE=false
